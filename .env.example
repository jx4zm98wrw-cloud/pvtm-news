# Copy to .env and fill in. monitor.mjs loads .env automatically.
# Leave a channel's vars blank to disable that channel.

# --- Telegram ---------------------------------------------------------------
# 1. Message @BotFather -> /newbot -> copy the token below.
# 2. Message your new bot once, then visit
#    https://api.telegram.org/bot<TOKEN>/getUpdates to find your chat id.
# TELEGRAM_CHAT_ID accepts a comma-separated list to reach several chats with
# one bot, e.g. TELEGRAM_CHAT_ID=111,222,333
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional extra bots (each with its own chat id list): _2 .. _5
# TELEGRAM_BOT_TOKEN_2=
# TELEGRAM_CHAT_ID_2=

# --- Email (SMTP) -----------------------------------------------------------
# Gmail example: host smtp.gmail.com, port 465, SMTP_SECURE=true,
# SMTP_PASS = a Google "App Password" (NOT your normal password).
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_TO=
# MAIL_FROM=   # optional; defaults to SMTP_USER
