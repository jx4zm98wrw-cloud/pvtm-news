# Copy to .env and fill in. monitor.mjs / monitor-ipvn.mjs load .env automatically.
# Convention: TRANSPORT is shared (no suffix); RECIPIENTS are per-monitor (_PVTM, _IPVN, …).
# Leave a recipient var blank to disable that channel for that monitor.

# --- Transport (shared by all monitors) -------------------------------------
# Telegram bot: @BotFather -> /newbot -> copy token. Message the bot once, then
# visit https://api.telegram.org/bot<TOKEN>/getUpdates to find a chat id.
TELEGRAM_BOT_TOKEN=
# Email SMTP. Gmail: host smtp.gmail.com, port 465, SMTP_SECURE=true,
# SMTP_PASS = a Google "App Password" (NOT your normal password).
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# MAIL_FROM=   # optional; defaults to SMTP_USER

# --- Monitor: PVTM (pvtm.gov.vn — phòng vệ thương mại) ----------------------
# Recipients. Comma-separated for multiple chats/emails. Blank = channel off.
TELEGRAM_CHAT_ID_PVTM=
MAIL_TO_PVTM=
# MAIL_BCC_PVTM=a@x.com,b@y.com   # optional hidden list — recipients don't see each other

# --- Monitor: IPVN (ipvietnam.gov.vn — Công báo SHCN) -----------------------
# Reuses the shared transport above; delivers ONLY to these — never falls back
# to the PVTM recipients. Blank = that channel off for this feed.
# TELEGRAM_CHAT_ID_IPVN=
# MAIL_TO_IPVN=

# --- Vercel webhook (auto-welcome new groups/channels) ----------------------
# Any random string; must match the secret_token passed to setWebhook.
# Used by api/telegram.mjs and set-webhook.mjs. Also set it in Vercel env vars.
WEBHOOK_SECRET=
# Welcome window when the bot joins a group (optional; defaults 30 days / max 8).
# WELCOME_DAYS=30
# WELCOME_CAP=8
